# Entity: language

main: kit: entity: language: {

  alias: field: {}

  fields: {
    isoCode: {
      h: "Iso Code"
      n: "isoCode"
      r: true
      sh: "ISO-639-1 language code"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Localized language names"
      t: "`$ARRAY`"
    }
  }

  name: "language"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /Languages"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "DE"
                k: "query"
                n: "language_iso_code"
                or: "languageIsoCode"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/Languages"
          rs: {
            alternatives: [
              {
                kind: "json"
                media: "text/json"
              }
              {
                kind: "raw"
                media: "text/csv"
              }
              {
                kind: "raw"
                media: "text/plain"
              }
            ]
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "Languages"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
